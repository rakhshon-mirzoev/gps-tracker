FROM golang:alpine AS builder

WORKDIR /app

ENV GOPROXY=https://goproxy.io,https://goproxy.cn,direct

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o admin ./cmd/admin/

FROM alpine

WORKDIR /cmd

COPY --from=builder /app/admin ./admin

RUN chmod +x ./admin

CMD ["./admin"]