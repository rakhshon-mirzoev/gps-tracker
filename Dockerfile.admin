FROM golang:alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o admin ./cmd/admin/

FROM alpine

WORKDIR /cmd

RUN apk add --no-cache tzdata

COPY --from=builder /app/admin ./admin

RUN chmod +x ./admin

ENV TZ=Asia/Dushanbe

CMD ["./admin"]