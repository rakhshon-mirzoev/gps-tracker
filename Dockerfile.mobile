FROM golang:alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o mobile ./cmd/mobile/

FROM alpine

WORKDIR /cmd

RUN apk add --no-cache tzdata

COPY --from=builder /app/mobile ./mobile

RUN chmod +x ./mobile

ENV TZ=Asia/Dushanbe

CMD ["./mobile"]