FROM golang:alpine AS builder

WORKDIR /app

ENV GOPROXY=https://goproxy.io,https://goproxy.cn,direct

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o mobile ./cmd/mobile/

FROM alpine

WORKDIR /cmd

COPY --from=builder /app/mobile ./mobile

RUN chmod +x ./mobile

CMD ["./mobile"]